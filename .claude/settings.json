{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run lint:api)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test:ci)",
      "Bash(npm run test:cov)",
      "Bash(npm run test:e2e)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:migrate:test)",
      "Bash(npx jest:*)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(npx redocly:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up -d:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list:*)",
      "Read(./**)",
      "Grep",
      "Glob"
    ],
    "ask": [
      "Bash(npm run db:migrate)",
      "Bash(npm run db:seed)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Write(./api/openapi.yaml)",
      "Edit(./api/openapi.yaml)",
      "Write(./prisma/**)",
      "Edit(./prisma/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.test)",
      "Read(./.env.seed)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-read.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-write.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-test-reminder.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  }
}
