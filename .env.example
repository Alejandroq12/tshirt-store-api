NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgresql://tshirt:tshirt@localhost:5432/tshirt_store?schema=public
REDIS_URL=redis://localhost:6379

# Set the exact proxy hop count in proxied deployments; never use true.
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

JWT_ACCESS_SECRET=dev-only-access-secret-replace-in-every-real-deployment
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-in-every-real-deployment
JWT_REFRESH_TTL=30d
PASSWORD_RESET_TOKEN_TTL=1h
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_PARALLELISM=1

PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_RATE_TTL_SECONDS=900

STORE_CURRENCY=USD

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=T-Shirt Store <no-reply@tshirt-store.test>

AWS_REGION=us-east-1
AWS_S3_BUCKET=tshirt-store-images-dev
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=2026-08-26.dahlia

# -- Docker Compose only -----------------------------------------------------
# POSTGRES_PORT must match the port in DATABASE_URL.
POSTGRES_USER=tshirt
POSTGRES_PASSWORD=tshirt
POSTGRES_DB=tshirt_store
POSTGRES_TEST_DB=tshirt_store_test
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
