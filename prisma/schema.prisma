generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER
  CLIENT

  @@map("user_role")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  CANCELLED

  @@map("order_status")
}

enum PaymentMethod {
  PAYMENT_LINK
  PAYMENT_INTENT

  @@map("payment_method")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  role         UserRole @default(CLIENT)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  cart                Cart?
  likes               ProductLike[]
  orders              Order[]
  createdPaymentLinks PaymentLink[]
  stockNotifications  StockNotification[]

  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], map: "idx_sessions_active")
  @@map("sessions")
}

model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  requestedIp String?   @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "idx_reset_ratelimit")
  @@map("password_reset_tokens")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
}

model Product {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  name          String    @db.VarChar(200)
  description   String?   @db.Text
  isActive      Boolean   @default(false) @map("is_active")
  lowStockCycle Int       @default(0) @map("low_stock_cycle")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images             ProductImage[]
  skus               ProductSku[]
  likes              ProductLike[]
  stockNotifications StockNotification[]

  @@index([categoryId], map: "idx_products_category")
  @@index([deletedAt, isActive, createdAt], map: "idx_products_state_listing")
  @@map("products")
}

model ProductImage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  url              String   @db.VarChar(500)
  s3Key            String   @map("s3_key") @db.VarChar(500)
  isFallback       Boolean  @map("is_fallback")
  isProductPrimary Boolean  @default(false) @map("is_product_primary")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuAssignments SkuImageAssignment[]

  @@unique([productId, id], map: "uq_product_image_parent")
  @@index([productId, isProductPrimary], map: "idx_images_product_primary")
  @@map("product_images")
}

model ProductSku {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  skuCode       String   @unique(map: "uq_skus_code") @map("sku_code") @db.VarChar(64)
  size          String   @db.VarChar(20)
  color         String   @db.VarChar(40)
  price         Decimal  @db.Decimal(10, 2)
  stockQuantity Int      @map("stock_quantity")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  imageAssignments SkuImageAssignment[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  paymentLinks     PaymentLink[]

  @@unique([productId, id], map: "uq_sku_parent")
  @@unique([productId, size, color], map: "uq_sku_variant")
  @@index([productId], map: "idx_skus_product")
  @@map("product_skus")
}

model SkuImageAssignment {
  productId String   @map("product_id") @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  imageId   String   @map("image_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sku   ProductSku   @relation(fields: [productId, skuId], references: [productId, id], onDelete: Cascade)
  image ProductImage @relation(fields: [productId, imageId], references: [productId, id], onDelete: Cascade)

  @@id([skuId, imageId], map: "pk_sku_image_assignment")
  @@index([productId, skuId], map: "idx_sku_image_sku_parent")
  @@index([productId, imageId], map: "idx_sku_image_asset_parent")
  @@map("sku_image_assignments")
}

model ProductLike {
  clientId  String   @map("client_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client  User    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([clientId, productId], map: "pk_product_like")
  @@index([productId], map: "idx_likes_product")
  @@map("product_likes")
}

model Cart {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @unique @map("client_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client User       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku  ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([cartId, skuId], map: "uq_cart_sku")
  @@index([skuId], map: "idx_cart_items_sku")
  @@map("cart_items")
}

model Order {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                String        @map("client_id") @db.Uuid
  status                  OrderStatus   @default(PENDING)
  paymentMethod           PaymentMethod @map("payment_method")
  totalAmount             Decimal       @map("total_amount") @db.Decimal(10, 2)
  paymentLinkId           String?       @map("payment_link_id") @db.Uuid
  stripeCheckoutSessionId String?       @unique @map("stripe_checkout_session_id") @db.VarChar(255)
  stripePaymentIntentId   String?       @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  paidAt                  DateTime?     @map("paid_at") @db.Timestamptz(6)
  cancelledAt             DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client      User         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  paymentLink PaymentLink? @relation(fields: [paymentLinkId], references: [id], onDelete: Restrict)

  items         OrderItem[]
  webhookEvents StripeWebhookEvent[]

  @@index([clientId, createdAt], map: "idx_orders_history")
  @@index([clientId, status], map: "idx_orders_client_status")
  @@index([clientId, totalAmount], map: "idx_orders_client_total")
  @@index([status], map: "idx_orders_status")
  @@index([paymentLinkId], map: "idx_orders_payment_link")
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  skuId       String  @map("sku_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  productName String  @map("product_name") @db.VarChar(200)
  skuCode     String  @map("sku_code") @db.VarChar(64)
  size        String  @db.VarChar(20)
  color       String  @db.VarChar(40)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @map("line_total") @db.Decimal(10, 2)

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   ProductSku @relation(fields: [productId, skuId], references: [productId, id], onDelete: Restrict)

  @@unique([orderId, skuId], map: "uq_order_sku")
  @@index([skuId], map: "idx_order_items_sku")
  @@index([productId], map: "idx_order_items_product")
  @@map("order_items")
}

model PaymentLink {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skuId               String   @map("sku_id") @db.Uuid
  quantity            Int
  stripePaymentLinkId String   @unique @map("stripe_payment_link_id") @db.VarChar(255)
  url                 String   @db.VarChar(500)
  createdBy           String   @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sku     ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)
  creator User       @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  orders Order[]

  @@index([createdBy], map: "idx_payment_links_creator")
  @@index([skuId], map: "idx_payment_links_sku")
  @@map("payment_links")
}

model StripeWebhookEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stripeEventId String    @unique @map("stripe_event_id") @db.VarChar(255)
  eventType     String    @map("event_type") @db.VarChar(100)
  orderId       String?   @map("order_id") @db.Uuid
  payload       Json      @db.JsonB
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  errorMessage  String?   @map("error_message") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([eventType], map: "idx_webhook_type")
  @@index([orderId], map: "idx_webhook_order")
  @@map("stripe_webhook_events")
}

model StockNotification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  lowStockCycle Int       @map("low_stock_cycle")
  stockAtSend   Int?      @map("stock_at_send")
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)

  client  User    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId, lowStockCycle], map: "uq_stock_notice_cycle")
  @@index([productId], map: "idx_stock_notice_product")
  @@map("stock_notifications")
}
